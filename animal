class Animal:
    def __init__(self, name):
        self.name = name
        self.hunger = 10

    def speak(self):
        print("...")

    def eat(self):
        self.hunger += 5
        print(f"{self.name} поел")

class Cat(Animal):
    def speak(self):
        print(f"{self.name}: Мяу")

class Dog(Animal):
    def speak(self):
        print(f"{self.name}: Гав")

zoo = [Cat("Барсик"), Dog("Бобик")]

for animal in zoo:
    animal.speak()
    animal.eat()
